<Window x:Class="DC_Font_Generator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DC Font Generator WPF" Height="720" Width="1100"
        MinHeight="560" MinWidth="860">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#a0a0a0" BorderThickness="1" Background="#f2f2f2" />

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#d0d0d0" />

        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="148" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0">
                <TabItem Header="Font" />
                <TabItem Header="Adjust" />
                <TabItem Header="Advance" />
                <TabItem Header="Fallout3.INI" />
                <TabItem Header="Log" />
            </TabControl>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Button Content="Render" Height="64" Margin="0,0,0,12" IsEnabled="False" />
                <Button Content="Load Project" Height="64" Margin="0,0,0,12" IsEnabled="False" />
                <Button Content="Save Project" Height="64" Margin="0,0,0,12" IsEnabled="False" />
                <Button Content="Save Font" Height="64" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="Ready" />
        </StatusBar>
    </Grid>
</Window>
