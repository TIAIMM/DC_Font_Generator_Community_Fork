<Window
    x:Class="DC_Font_Generator.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DC_Font_Generator.WinUI.ViewModels"
    Title="DC Font Generator WinUI">

    <Grid x:Name="RootGrid"
          MinWidth="1080"
          MinHeight="680"
          Padding="8"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="500,*"
          ColumnSpacing="10"
          RowSpacing="8">
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnDefinitions="*,*,*,*,*"
                  MinHeight="48">
                <ToggleButton x:Name="FontPageButton"
                              Grid.Column="0"
                              Content="字体"
                              Tag="FontPagePanel"
                              IsChecked="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Click="MainPageButton_Click"/>
                <ToggleButton x:Name="AdjustPageButton"
                              Grid.Column="1"
                              Content="调整"
                              Tag="AdjustPagePanel"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Click="MainPageButton_Click"/>
                <ToggleButton x:Name="AdvancedPageButton"
                              Grid.Column="2"
                              Content="高级"
                              Tag="AdvancedPagePanel"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Click="MainPageButton_Click"/>
                <ToggleButton x:Name="IniPageButton"
                              Grid.Column="3"
                              Content="Fallout3.INI"
                              Tag="IniPagePanel"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Click="MainPageButton_Click"/>
                <ToggleButton x:Name="LogPageButton"
                              Grid.Column="4"
                              Content="日志"
                              Tag="LogPagePanel"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              Click="MainPageButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid x:Name="PageContentHost">
                <ScrollViewer x:Name="FontPagePanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="12" Padding="8">
                            <TextBlock Text="编码与贴图" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <TextBlock Text="编码" VerticalAlignment="Center"/>
                                <ComboBox x:Name="EncodingComboBox"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="EncodingComboBox_SelectionChanged"/>

                                <TextBlock Grid.Row="1" Text="Tex 宽" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SizeXComboBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="TexSizeComboBox_SelectionChanged"/>

                                <TextBlock Grid.Row="2" Text="Tex 高" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SizeYComboBox"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="TexSizeComboBox_SelectionChanged"/>

                                <TextBlock x:Name="TexSizeTextBlock"
                                           Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <TextBlock Text="字体" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <TextBlock Text="单字节" VerticalAlignment="Center"/>
                                <TextBox x:Name="SingleFontTextBox"
                                         Grid.Column="1"
                                         IsReadOnly="True"/>
                                <Button Grid.Column="2" Content="选择" Click="SelectSingleFont_Click"/>

                                <TextBlock Grid.Row="1" Text="双字节" VerticalAlignment="Center"/>
                                <TextBox x:Name="DoubleFontTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         IsReadOnly="True"/>
                                <Button x:Name="SelectDoubleFontButton"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Content="选择"
                                        Click="SelectDoubleFont_Click"/>
                            </Grid>

                            <TextBlock Text="效果" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,128,88"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <TextBlock Text="光晕" VerticalAlignment="Center"/>
                                <NumberBox x:Name="GlowNumberBox"
                                           Grid.Column="1"
                                           Minimum="0"
                                           Maximum="64"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="GlowNumberBox_ValueChanged"/>
                                <Button x:Name="GlowColorButton"
                                        Grid.Column="2"
                                        Content="颜色"
                                        Click="GlowColorButton_Click"/>

                                <TextBlock Grid.Row="1" Text="描边" VerticalAlignment="Center"/>
                                <NumberBox x:Name="OutlineNumberBox"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Minimum="0"
                                           Maximum="64"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="OutlineNumberBox_ValueChanged"/>
                                <Button x:Name="OutlineColorButton"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Content="颜色"
                                        Click="OutlineColorButton_Click"/>

                                <TextBlock Grid.Row="2" Text="字体颜色" VerticalAlignment="Center"/>
                                <Button x:Name="FontColorButton"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Content="颜色"
                                        Click="FontColorButton_Click"/>
                            </Grid>

                            <TextBlock Text="布局与名称" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,140,*"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <CheckBox x:Name="FixedFontCheckBox"
                                          Content="等宽字体"
                                          Checked="FixedFontCheckBox_Changed"
                                          Unchecked="FixedFontCheckBox_Changed"/>
                                <NumberBox x:Name="FixedWidthNumberBox"
                                           Grid.Column="1"
                                           Minimum="1"
                                           Maximum="256"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="FixedWidthNumberBox_ValueChanged"/>

                                <CheckBox x:Name="AutoBaseLineCheckBox"
                                          Grid.Row="1"
                                          Content="自动基线"
                                          Checked="AutoBaseLineCheckBox_Changed"
                                          Unchecked="AutoBaseLineCheckBox_Changed"/>
                                <NumberBox x:Name="BaseLineNumberBox"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Minimum="1"
                                           Maximum="256"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="BaseLineNumberBox_ValueChanged"/>

                                <TextBlock Grid.Row="2" Text="FNT 名称" VerticalAlignment="Center"/>
                                <TextBox x:Name="FntNameTextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         TextChanged="FntNameTextBox_TextChanged"/>

                                <TextBlock Grid.Row="3" Text="Tex 名称" VerticalAlignment="Center"/>
                                <TextBox x:Name="TexNameTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         TextChanged="TexNameTextBox_TextChanged"/>
                            </Grid>

                            <TextBlock Text="字体段" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <Button Content="上一段" Click="PreviousSection_Click"/>
                                <Button Grid.Column="1" Content="下一段" Click="NextSection_Click"/>
                                <Button Grid.Row="1" Content="新增段" Click="AddSection_Click"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="删除段" Click="RemoveSection_Click"/>
                                <TextBlock x:Name="FntLabelTextBlock"
                                           Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Content="导入 FNT" Click="ImportFnt_Click"/>
                                <Button x:Name="LinkFontButton"
                                        Grid.Column="1"
                                        Content="Link Font"
                                        Click="LinkFont_Click"/>
                                <Button Grid.Column="2" Content="清空" Click="Clear_Click"/>
                            </Grid>

                            <TextBlock Text="保存后写入 INI 槽位" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*,*,*"
                                  RowSpacing="8">
                                <CheckBox x:Name="IniLink1CheckBox" Content="1" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink2CheckBox" Grid.Column="1" Content="2" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink3CheckBox" Grid.Column="2" Content="3" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink4CheckBox" Grid.Column="3" Content="4" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink5CheckBox" Grid.Row="1" Content="5" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink6CheckBox" Grid.Row="1" Grid.Column="1" Content="6" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink7CheckBox" Grid.Row="1" Grid.Column="2" Content="7" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                                <CheckBox x:Name="IniLink8CheckBox" Grid.Row="1" Grid.Column="3" Content="8" Checked="IniLinkCheckBox_Changed" Unchecked="IniLinkCheckBox_Changed"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                <Grid x:Name="AdjustPagePanel"
                      Visibility="Collapsed"
                      Padding="8"
                          RowDefinitions="Auto,*"
                      RowSpacing="10">
                        <StackPanel Spacing="8">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,128"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <ComboBox x:Name="AdjustmentModeComboBox" Header="调整项"/>
                                <NumberBox x:Name="IncrementNumberBox"
                                           Grid.Column="1"
                                           Header="增量"
                                           Value="1"
                                           Minimum="0.01"
                                           Maximum="256"
                                           SmallChange="0.5"
                                           SpinButtonPlacementMode="Compact"/>
                                <Grid Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,*,*"
                                      ColumnSpacing="8">
                                    <Button Content="-" Click="AdjustDecrease_Click"/>
                                    <Button Grid.Column="1" Content="+" Click="AdjustIncrease_Click"/>
                                    <Button Grid.Column="2" Content="Restore" Click="RestoreAdjust_Click"/>
                                </Grid>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <CheckBox x:Name="SelectSingleByteCheckBox"
                                          Content="选择单字节字符集"
                                          Checked="SelectSingleByteCheckBox_Changed"
                                          Unchecked="SelectSingleByteCheckBox_Changed"/>
                                <CheckBox x:Name="SelectDoubleByteCheckBox"
                                          Grid.Column="1"
                                          Content="选择双字节字符集"
                                          Checked="SelectDoubleByteCheckBox_Changed"
                                          Unchecked="SelectDoubleByteCheckBox_Changed"/>
                            </Grid>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <TextBox x:Name="RangeStartTextBox" Header="From Hex" TextChanged="RangeHexTextBox_TextChanged"/>
                                    <TextBox x:Name="FromCharTextBox" Grid.Column="1" Header="From Character" TextChanged="RangeCharTextBox_TextChanged"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <TextBox x:Name="RangeEndTextBox" Header="To Hex" TextChanged="RangeHexTextBox_TextChanged"/>
                                    <TextBox x:Name="ToCharTextBox" Grid.Column="1" Header="To Character" TextChanged="RangeCharTextBox_TextChanged"/>
                                </Grid>
                                <Button Content="选择范围" Click="SelectRange_Click"/>
                                <TextBox x:Name="SampleTextBox"
                                         Header="预览文本"
                                         IsSpellCheckEnabled="False"
                                         IsTextPredictionEnabled="False"
                                         TextChanged="SampleTextBox_TextChanged"/>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="White"
                                        Height="150">
                                    <ScrollViewer HorizontalScrollBarVisibility="Visible"
                                                  VerticalScrollBarVisibility="Visible"
                                                  Background="White">
                                        <ScrollViewer.Resources>
                                            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#F5F5F5"/>
                                            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FFD45A"/>
                                            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#808080"/>
                                            <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ScrollBarPanningThumbBackgroundDisabled" Color="#808080"/>
                                            <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#101010"/>
                                            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#101010"/>
                                            <SolidColorBrush x:Key="ScrollBarTrackFillPressed" Color="#101010"/>
                                            <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#101010"/>
                                            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#202020"/>
                                            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#303030"/>
                                        </ScrollViewer.Resources>
                                        <Image x:Name="SamplePreviewImage"
                                               Stretch="None"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                <ScrollViewer x:Name="AdvancedPagePanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                        <StackPanel Padding="8" Spacing="12">
                            <TextBlock Text="贴图布局" FontWeight="SemiBold"/>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <TextBlock Text="Gap" VerticalAlignment="Center"/>
                                <NumberBox x:Name="GapNumberBox"
                                           Grid.Column="1"
                                           Minimum="0"
                                           Maximum="64"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="GapNumberBox_ValueChanged"/>

                                <TextBlock Grid.Row="1" Text="排列" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ArrangeComboBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ArrangeComboBox_SelectionChanged"/>

                                <Button x:Name="BackgroundColorButton"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="背景色"
                                        Click="BackgroundColorButton_Click"/>
                            </Grid>

                            <TextBlock Text="导入与转换" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  RowSpacing="8">
                                <Button Content="导入编码文本" Click="ImportEncodingText_Click"/>
                                <Button Grid.Column="1" Content="导出 CodepageDebug" Click="ExportCodepageDebug_Click"/>
                                <Button Grid.Row="1" Content="导入 Tex" Click="ImportTex_Click"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="导入 PNG" Click="ImportPng_Click"/>
                                <Button Grid.Row="2" Content="Tex -> PNG" Click="ConvertTexToPng_Click"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="PNG -> Tex" Click="ConvertPngToTex_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                <Grid x:Name="IniPagePanel"
                      Visibility="Collapsed"
                      Padding="8"
                          RowDefinitions="Auto,*"
                      RowSpacing="8">
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="8">
                            <Button Content="检测环境" Click="DetectIni_Click"/>
                            <Button Grid.Column="1" Content="默认字体" Click="DefaultIni_Click"/>
                            <Button Grid.Row="1" Content="Load INI" Click="LoadIni_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Save INI" Click="SaveIni_Click"/>
                        </Grid>
                        <ListView x:Name="IniSlotsList" Grid.Row="1">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="96,*"
                                          Padding="0,3"
                                          ColumnSpacing="6">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Items}"
                                                  SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                                  SelectionChanged="IniSlotComboBox_SelectionChanged"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                <Grid x:Name="LogPagePanel"
                      Visibility="Collapsed"
                      Padding="8">
                        <TextBox x:Name="LogTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 IsReadOnly="True"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="1"
              RowDefinitions="*,Auto,Auto"
              RowSpacing="6">
            <Border Grid.Row="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Visible"
                              ZoomMode="Enabled"
                              Background="White">
                    <ScrollViewer.Resources>
                        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#F5F5F5"/>
                        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#FFD45A"/>
                        <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#808080"/>
                        <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ScrollBarPanningThumbBackgroundDisabled" Color="#808080"/>
                        <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#101010"/>
                        <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#101010"/>
                        <SolidColorBrush x:Key="ScrollBarTrackFillPressed" Color="#101010"/>
                        <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#101010"/>
                        <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#202020"/>
                        <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#303030"/>
                    </ScrollViewer.Resources>
                    <Grid x:Name="AtlasContentGrid"
                          Background="White"
                          PointerReleased="AtlasImage_PointerReleased"
                          PointerMoved="AtlasImage_PointerMoved"
                          PointerExited="AtlasImage_PointerExited">
                        <Image x:Name="AtlasImage"
                               Stretch="None"
                               IsHitTestVisible="False"/>
                        <Canvas x:Name="AtlasOverlay"
                                IsHitTestVisible="False">
                            <Border x:Name="HoverGlyphBorder"
                                    BorderBrush="Red"
                                    BorderThickness="1"
                                    Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">
                <Button x:Name="RenderButton" Content="Render" MinWidth="88" Click="RenderButton_Click"/>
                <Button x:Name="LoadProjectButton" Grid.Column="1" Content="Load Project" MinWidth="104" Click="LoadProjectButton_Click"/>
                <Button x:Name="SaveProjectButton" Grid.Column="2" Content="Save Project" MinWidth="104" Click="SaveProjectButton_Click"/>
                <Button x:Name="SaveFontButton" Grid.Column="3" Content="Save Font" MinWidth="88" Click="SaveFontButton_Click"/>
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8"
                  VerticalAlignment="Center">
                <TextBlock x:Name="ProgressLabelTextBlock"
                           Text="进度"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <ProgressBar x:Name="ProgressBar"
                             Grid.Column="1"
                             Minimum="0"
                             Maximum="1"
                             Height="8"
                             MinWidth="220"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="ProgressTextBlock"
                           Grid.Column="2"
                           MinWidth="140"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   MinHeight="24"
                   VerticalAlignment="Center"
                   TextWrapping="NoWrap"/>

        <Popup x:Name="GlyphToolTipPopup"
               Grid.RowSpan="3"
               Grid.ColumnSpan="2"
               IsLightDismissEnabled="False">
            <Border x:Name="GlyphToolTipBorder"
                    Background="White"
                    BorderBrush="#C0C0C0"
                    BorderThickness="1"
                    Padding="6"
                    MaxWidth="280">
                <TextBlock x:Name="GlyphToolTipTextBlock"
                           Foreground="#202020"
                           TextWrapping="Wrap"/>
            </Border>
        </Popup>
    </Grid>
</Window>